/* ============================================================
   Broca TUI - Theme System
   Mapped from broca-web/frontend/src/styles/theme.css
   ============================================================ */

/* ===== Color System ===== */

/* Primary - Light blue */
$primary-50: #f0f9ff;
$primary-100: #e0f2fe;
$primary-200: #bae6fd;
$primary-300: #7dd3fc;
$primary-400: #38bdf8;
$primary-500: #0ea5e9;
$primary-600: #0284c7;
$primary-700: #0369a1;
$primary-800: #075985;
$primary-900: #0c4a6e;

/* Neutral - Gray */
$gray-50: #f8fafc;
$gray-100: #f1f5f9;
$gray-200: #e2e8f0;
$gray-300: #cbd5e1;
$gray-400: #94a3b8;
$gray-500: #64748b;
$gray-600: #475569;
$gray-700: #334155;
$gray-800: #1e293b;
$gray-900: #0f172a;

/* Functional colors */
$success: #10b981;
$warning: #f59e0b;
$error: #ef4444;
$info: $primary-500;

/* ===== Message Type Colors ===== */
$msg-user-bg: #eff6ff;
$msg-user-border: #3b82f6;
$msg-user-text: #1e40af;

$msg-agent-bg: #f0fdf4;
$msg-agent-border: #22c55e;
$msg-agent-text: #166534;

$msg-tool-bg: #faf5ff;
$msg-tool-border: #a855f7;
$msg-tool-text: #6b21a8;

$msg-system-bg: $gray-100;
$msg-system-border: $gray-300;
$msg-system-text: $gray-500;

$msg-error-bg: #fef2f2;
$msg-error-border: #ef4444;
$msg-error-text: #991b1b;

/* ===== Layout ===== */
$header-height: 3;
$sidebar-width: 20%;
$input-height: 3;

/* ===== Spacing ===== */
$space-1: 1;
$space-2: 2;
$space-3: 3;
$space-4: 4;

/* ===== Typography ===== */
$text-xs: 10;
$text-sm: 12;
$text-base: 14;
$text-lg: 16;
$text-xl: 20;
$text-2xl: 24;

/* ===== Borders ===== */
$border-radius-sm: 1;
$border-radius: 2;
$border-radius-md: 3;
$border-radius-lg: 4;
