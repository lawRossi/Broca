# ============================================================
# Broca Web Backend — Production Configuration Template
# ============================================================
# Copy to `.env.production` and fill in required values.
# All fields marked REQUIRED must be set or the server will fail to start.

# --- Environment ---
ENV=production

# --- Server ---
PORT=9001
HOST=0.0.0.0
BROCA_SOCKETIO_PORT=6666
BROCA_SOCKETIO_ENABLED=true
RELOAD=false

# --- CORS (REQUIRED: must be explicit, * is rejected in production) ---
# Comma-separated list of allowed origins
CORS_ALLOW_ORIGINS=https://your-domain.com

# --- JWT (REQUIRED: must be a strong random secret, not the default) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<your-64-char-hex-secret>
JWT_EXPIRE_MINUTES=2880

# --- Database ---
DATABASE_TYPE=sqlite
SQLITE_DATABASE_PATH=sqlite:////opt/broca/data/web.db
# Or for PostgreSQL:
# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/broca
# DATABASE_URL_SYNC=postgresql://user:pass@host:5432/broca

# --- Broca Config ---
BROCA_CONFIG=/opt/broca/configs/configs.json
BROCA_DATABASE_DIR=/opt/broca/data
