# ============================================================
# Broca Web Backend — Environment Configuration
# ============================================================
# 所有配置来自此文件（纯文件驱动，不读取系统环境变量）
# Copy to `.env.local` (development) or `.env.production` (production)
# and override the values as needed.

# --- Environment ---
# "dev" (default): 项目 configs/configs.json 优先
# "production": ~/.broca/configs.json 优先 + 安全护栏
ENV=dev

# --- Server ---
# HTTP API port (priority: this .env > configs.json api_server_url > default 9001)
PORT=9001
# Host binding (default: 0.0.0.0)
HOST=0.0.0.0
# Enable uvicorn auto-reload (default: true, set false in production)
RELOAD=true

# --- SocketIO ---
# Enable/disable the embedded SocketIO server (default: true)
BROCA_SOCKETIO_ENABLED=true
# SocketIO host (default: 0.0.0.0)
BROCA_SOCKETIO_HOST=0.0.0.0
# SocketIO port (priority: this .env > configs.json socket_server_url > default 6666)
BROCA_SOCKETIO_PORT=6666
# CORS origins for SocketIO (default: *)
BROCA_SOCKETIO_CORS=*

# --- CORS (HTTP API) ---
# Comma-separated list of allowed origins (default: *, 生产必须显式设置)
CORS_ALLOW_ORIGINS=*

# --- Database ---
# "sqlite" or "postgresql"
DATABASE_TYPE=sqlite
# SQLite file path (used when DATABASE_TYPE=sqlite)
SQLITE_DATABASE_PATH=sqlite:///./dev.db
# PostgreSQL URL (used when DATABASE_TYPE=postgresql)
DATABASE_URL=
DATABASE_URL_SYNC=

# --- JWT Authentication ---
# Change this in production!
JWT_SECRET=broca-default-dev-secret-change-in-production
# Token expiration in minutes (default: 2880 = 2 days)
JWT_EXPIRE_MINUTES=2880

# --- Broca Config ---
# Path to configs.json (if empty, auto-discovered: project → ~/.broca)
BROCA_CONFIG=
# Override database directory (optional)
BROCA_DATABASE_DIR=

# --- LLM (optional, for agent configuration page) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
