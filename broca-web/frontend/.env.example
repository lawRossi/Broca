# ============================================================
# Broca Web Frontend — Environment Configuration
# ============================================================
# Copy to `.env` (shared defaults) and override in `.env.local` (personal, gitignored).
# Vite automatically loads: `.env` → `.env.local` → `.env.[mode]`
# Secrets (API keys) should go in `.env.local`, NOT in `.env`.

# --- Backend API ---
# Vite dev proxy target for /api requests (default: http://127.0.0.1:9001)
# Worktree example: VITE_BACKEND_URL=http://127.0.0.1:9002
VITE_BACKEND_URL=http://127.0.0.1:9001

# --- SocketIO ---
# SocketIO server URL (Socket.IO client 内部处理 ws 升级, 填 http)
# 留空 = 通过 Vite 代理走同域（从 VITE_BACKEND_URL 推导 host，端口固定 6666）
# 显式设置时覆盖: VITE_BROCA_SOCKET_SERVER_URL=http://127.0.0.1:6667
VITE_BROCA_SOCKET_SERVER_URL=

# --- ASR (Speech Recognition) ---
# Full WebSocket URL for ASR streaming (optional; falls back to same-origin /api/asr/stream)
# VITE_ASR_WS_URL=ws://127.0.0.1:9001
